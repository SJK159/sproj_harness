# Copy to .env and fill in. Never commit .env.

# Model as a provider:model string.
# Dev: Databricks Free Edition serving endpoint, called via its OpenAI-compatible API.
#   databricks:databricks-gpt-oss-120b
HARNESS_MODEL=

# Databricks Model Serving
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sproj-harness

# Optional: mock Zambeel / workflow DB path (default data/harness.db)
HARNESS_DB=

# HMAC secret for approval tokens. At least 32 characters; mint and verify refuse to run otherwise.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SECRET=

# Local MCP transport (optional; original local tools remain the default).
# Servers bind to loopback. Demo actor headers are claims, not authentication.
HARNESS_USE_MCP=false
HARNESS_FE_MCP_URL=http://127.0.0.1:8101/mcp
HARNESS_ZAMBEEL_MCP_URL=http://127.0.0.1:8102/mcp
# Different from APPROVAL_SECRET; at least 32 characters. Used only for internal FE -> Zambeel calls.
HARNESS_MCP_SERVICE_SECRET=

# Azure OpenAI v1: set HARNESS_MODEL=azure_v1:gpt-5-mini-group4
# The endpoint must include /openai/v1/. No dated API version is required.
# HARNESS_MODEL is authoritative; AZURE_OPENAI_DEPLOYMENT is informational.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-group4
# Unused for the v1 provider; retained for legacy Azure examples only.
AZURE_OPENAI_API_VERSION=