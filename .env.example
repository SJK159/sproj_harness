# Copy to .env and fill in. Never commit .env.

# demo retains the loopback workflow. bff uses backend-managed sign-in/cookies.
# entra is the legacy isolated bearer-verifier test mode. Unknown modes fail.
HARNESS_AUTH_MODE=demo
# For legacy entra mode only, use the HARNESS API audience/scope.
HARNESS_ENTRA_TENANT_ID=
HARNESS_API_AUDIENCE=
HARNESS_API_SCOPE=
# Absolute path to an operator-managed JSON array; never put credentials in it.
# [{"tenant_id":"...","object_id":"...","actor_id":"S1","role":"Student"}]
HARNESS_IDENTITY_MAP=

# BFF configuration. Public IDs match the 2026-11-16 handoff; no secrets below.
HARNESS_CLIENT_ID=a7baa7d9-576c-4be3-9bfe-ec5fedfd316c
HARNESS_CLIENT_SECRET=
HARNESS_CALLBACK_URL=http://localhost:8000/auth/callback
HARNESS_FRONTEND_ORIGIN=http://localhost:5173
# Set false explicitly ONLY for the registered loopback HTTP callback above.
HARNESS_COOKIE_SECURE=true
HARNESS_AUTH_DB=data/auth.db
HARNESS_SESSION_KEY=
HARNESS_SESSION_KEY_FILE=data/auth.key
HARNESS_FE_SCOPE=api://04ce3e46-2e44-4c4c-949f-09ce52e2a17b/mcp.access
HARNESS_ZAMBEEL_SCOPE=api://9fd72d08-229f-4b7e-9733-7a23689c4cfa/mcp.access
HARNESS_MCP_ALLOW_LOOPBACK=false
# Select a separate ignored config via HARNESS_ENV_FILE=.env.bff.local.

# Durable worker (requires Nausher's service-only FE operation + app permission).
# No demo fallback. Scope is the FE resource's /.default; permission is granted
# to the worker app as Cases.ExecuteApproved, enforced by FE.
HARNESS_WORKER_FE_URL=
HARNESS_WORKER_CLIENT_ID=
HARNESS_WORKER_CLIENT_SECRET=
HARNESS_WORKER_FE_SCOPE=

# Model as a provider:model string.
# Dev: Databricks Free Edition serving endpoint, called via its OpenAI-compatible API.
#   databricks:databricks-gpt-oss-120b
HARNESS_MODEL=

# Databricks Model Serving
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sproj-harness

# Optional: mock Zambeel / workflow DB path (default data/harness.db)
HARNESS_DB=

# HMAC secret for approval tokens. At least 32 characters; mint and verify refuse to run otherwise.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_SECRET=

# Local MCP transport (optional; original local tools remain the default).
# Servers bind to loopback. Demo actor headers are claims, not authentication.
HARNESS_USE_MCP=false
HARNESS_FE_MCP_URL=http://127.0.0.1:8101/mcp
HARNESS_ZAMBEEL_MCP_URL=http://127.0.0.1:8102/mcp
# Different from APPROVAL_SECRET; at least 32 characters. Used only for internal FE -> Zambeel calls.
HARNESS_MCP_SERVICE_SECRET=

# Azure OpenAI v1: set HARNESS_MODEL=azure_v1:gpt-5-mini-group4
# The endpoint must include /openai/v1/. No dated API version is required.
# HARNESS_MODEL is authoritative; AZURE_OPENAI_DEPLOYMENT is informational.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini-group4
# Unused for the v1 provider; retained for legacy Azure examples only.
AZURE_OPENAI_API_VERSION=
