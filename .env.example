# Copy to .env and fill in. Never commit .env.

# Model as a provider:model string.
# Dev: Databricks Free Edition serving endpoint, called via its OpenAI-compatible API.
#   databricks:databricks-gpt-oss-120b
HARNESS_MODEL=

# Databricks Model Serving
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sproj-harness

# Optional: mock Zambeel / workflow DB path (default data/harness.db)
HARNESS_DB=

# HMAC secret for approval tokens (used from M2). Any long random string.
APPROVAL_SECRET=
